{
  "info": {
    "_postman_id": "3a7d0c1e-b2f4-4e6a-9c1d-5f8e2a0b7c4d",
    "name": "SynapseShop API",
    "description": "Coleção dos endpoints da API SynapseShop. Prefixo versionado /api/v1/. Recursos: Categorias (nome, descricao), Itens (nome, descricao, preco, estoque, categoria) e Pedidos (user_id, status, total, created_at). As requisições de cache ficam na pasta Pedidos: a lista e o detalhe usam cache-aside no Redis e retornam cache=miss na primeira chamada, cache=hit na segunda e registram as métricas em /pedidos/metricas-cache/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "cat_id",
      "value": "1"
    },
    {
      "key": "item_id",
      "value": "1"
    },
    {
      "key": "pedido_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Categorias",
      "item": [
        {
          "name": "Listar categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", ""]
            },
            "description": "Lista todas as categorias. Esperado 200 OK."
          }
        },
        {
          "name": "Criar categoria",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Papelaria\",\n  \"descricao\": \"Material de papelaria\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", ""]
            },
            "description": "Cria uma categoria. Esperado 201 Created."
          }
        },
        {
          "name": "Obter categoria por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{cat_id}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{cat_id}}", ""]
            },
            "description": "Recupera uma categoria. Esperado 200 OK."
          }
        },
        {
          "name": "Atualizar categoria (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Papelaria Premium\",\n  \"descricao\": \"Materiais escolares selecionados\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{cat_id}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{cat_id}}", ""]
            },
            "description": "Substitui uma categoria por completo. Esperado 200 OK."
          }
        },
        {
          "name": "Atualizar parcialmente (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Atualização parcial\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{cat_id}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{cat_id}}", ""]
            },
            "description": "Atualiza apenas os campos enviados. Esperado 200 OK."
          }
        },
        {
          "name": "Excluir categoria",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{cat_id}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{cat_id}}", ""]
            },
            "description": "Exclui uma categoria. Esperado 204 No Content."
          }
        }
      ]
    },
    {
      "name": "Itens",
      "item": [
