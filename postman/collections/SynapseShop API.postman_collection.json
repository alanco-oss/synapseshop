          "name": "Listar itens",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", ""]
            },
            "description": "Lista todos os itens do catálogo. Esperado 200 OK."
          }
        },
        {
