{
  "info": {
    "_postman_id": "9c2e5f5b-8f8e-4c7a-a4d2-0e6b5d1a3a7c",
    "name": "SynapseShop API",
    "description": "Coleção dos endpoints CRUD da API principal (Aula 4). Prefixo versionado /api/v1/. Recurso: Produto (nome, preco, estoque).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "produto_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Listar produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/produtos/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "produtos", ""]
        },
        "description": "Lista todos os produtos. Esperado 200 OK."
      }
    },
    {
      "name": "Criar produto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Caderno pautado\",\n  \"preco\": \"9.90\",\n  \"estoque\": 50\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/produtos/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "produtos", ""]
        },
        "description": "Cria um produto. Esperado 201 Created."
      }
    },
    {
      "name": "Obter produto por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/produtos/{{produto_id}}/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "produtos", "{{produto_id}}", ""]
        },
        "description": "Recupera um produto. Esperado 200 OK."
      }
    },
    {
      "name": "Atualizar produto (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Caderno pautado\",\n  \"preco\": \"12.90\",\n  \"estoque\": 45\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/produtos/{{produto_id}}/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "produtos", "{{produto_id}}", ""]
        },
        "description": "Substitui um produto por completo. Esperado 200 OK."
      }
    },
    {
      "name": "Atualizar parcialmente (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estoque\": 40\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/produtos/{{produto_id}}/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "produtos", "{{produto_id}}", ""]
        },
        "description": "Atualiza apenas os campos enviados. Esperado 200 OK."
      }
    },
    {
      "name": "Excluir produto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/produtos/{{produto_id}}/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "produtos", "{{produto_id}}", ""]
        },
        "description": "Exclui um produto. Esperado 204 No Content."
      }
    }
  ]
}